# ── Jarcord config, copy to .env and fill in ──
DISCORD_TOKEN=your-bot-token-here
COMMAND_PREFIX=!
GUILD_ID=000000000000000000
# optional, switches /ask on. Any endpoint that speaks the OpenAI chat shape works.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# where the database lives. Tests set this to :memory: themselves.
# JARCORD_DB=data/jarcord.db
