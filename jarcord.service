[Unit]
Description=Jarcord: ROC faction Discord bot
After=network-online.target
Wants=network-online.target

[Service]
# unbuffered, otherwise the >> lines never reach journalctl
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/jarcord
ExecStart=/opt/jarcord/venv/bin/python bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
